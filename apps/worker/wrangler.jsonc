{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyeboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "HYEB_ALLOWED_ORIGINS": "",
    "HYEB_BROWSER_WS_ENDPOINT": "",
    "HYEB_LOG_LEVEL": "debug",
    "VNU_FAR_WALK_ENABLED": "true",
    "VNU_CODE_LOOKUP_CONCURRENCY": "16",
    "VNU_CROSS_LOOKUP_BULK_MAX_TARGETS": "500",
    "VNU_CROSS_LOOKUP_DIRECT_CHUNK_MAX_TARGETS": "32",
    "VNU_CODE_LOOKUP_BULK_TARGET_CONCURRENCY": "3",
    "VNU_CROSS_LOOKUP_REQUEST_TIMEOUT_MS": "60000",
    "VNU_CROSS_DETAIL_MAX_TARGETS": "50",
    "VNU_CROSS_DETAIL_MAX_ROWS": "200",
    "VNU_CROSS_DETAIL_CONCURRENCY": "6",
    "VNU_CROSS_DETAIL_BUDGET": "300",
    "VNU_CROSS_DETAIL_WINDOW_SECONDS": "600",
    "VNU_CROSS_DETAIL_EXPORT_MODE": "selected",
    "VNU_CROSS_DETAIL_PERMIT_TTL_SECONDS": "1200"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTCHA_RELAY",
        "class_name": "CaptchaRelayDurableObject"
      },
      {
        "name": "FEATURE_POLICY",
        "class_name": "FeaturePolicyDurableObject"
      },
      {
        "name": "VNU_PROBE_BUDGET",
        "class_name": "VnuProbeBudgetDurableObject"
      },
      {
        "name": "VNU_REFRESH_CONTROL",
        "class_name": "VnuRefreshControlDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaptchaRelayDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VnuProbeBudgetDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["VnuRefreshControlDurableObject"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FeaturePolicyDurableObject"]
    }
  ],
  "secrets": {
    "required": ["HYEB_SESSION_SECRET", "HYEB_ADMIN_SESSION_SECRET"]
  }
}
