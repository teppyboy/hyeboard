{
  "name": "@hyeboard/worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --show-interactive-dev-session=false --log-level info",
    "dev:node": "tsx src/index.node.ts",
    "dev:bun": "bun --watch src/index.node.ts",
    "deploy": "wrangler deploy",
    "build:node": "node scripts/build-node.mjs",
    "check:node-package": "node scripts/check-node-package.mjs",
    "typecheck:ha": "tsc -p ../../scripts/ha/tsconfig.json --noEmit",
    "test:ha:postgres": "vitest run --config vitest.postgres.config.ts --reporter=verbose",
    "test:ha:redis": "vitest run --config vitest.redis.config.ts --reporter=verbose",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "serve:node": "node dist/index.js",
    "serve:bun": "bun run dist/index.js",
    "wrangler": "wrangler",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vitest run --exclude 'test/**' && pnpm test:workers"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@hyeboard/core": "workspace:*",
    "@hyeboard/schemas": "workspace:*",
    "@hyeboard/university-adapters": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.29",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "rolldown": "^1.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
