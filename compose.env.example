# Copy to compose.env and fill every required value before starting Compose.
#
# Memory mode:
#   docker compose --env-file compose.env --profile memory up -d --build
# Distributed mode:
#   docker compose --env-file compose.env --profile distributed up -d --build

# At least 32 random characters. Keep this outside source control.
HYEB_SESSION_SECRET=

# Admin credentials. Generate HYEB_ADMIN_PASSWORD_HASH with the masked
# `pnpm --filter @hyeboard/worker admin:hash-password` prompt.
HYEB_ADMIN_SESSION_SECRET=
HYEB_ADMIN_PASSWORD_HASH=
HYEB_ADMIN_SESSION_TTL_SECONDS=3600
HYEB_ADMIN_GITHUB_CLIENT_ID=
HYEB_ADMIN_GITHUB_CLIENT_SECRET=
HYEB_ADMIN_GITHUB_IDS=
HYEB_ADMIN_DISCORD_CLIENT_ID=
HYEB_ADMIN_DISCORD_CLIENT_SECRET=
HYEB_ADMIN_DISCORD_IDS=
HYEB_ADMIN_PUBLIC_ORIGIN=http://localhost:8787
# Memory mode only. Mount this path on durable writable storage if admin policy
# history must survive container replacement.
HYEB_ADMIN_DB_PATH=./data/admin.sqlite

# PostgreSQL is initialized with this password. Use URL-safe characters because
# the Compose API URL is generated from this value (for example, `openssl rand
# -hex 24`).
POSTGRES_PASSWORD=

# Required by both the API envelope backend and the automation worker.
AUTOMATION_KEY_CURRENT_ID=
AUTOMATION_KEY_CURRENT_B64=
# Optional key rotation pair; provide both or neither.
AUTOMATION_KEY_PREVIOUS_ID=
AUTOMATION_KEY_PREVIOUS_B64=

# Browserless access token. The endpoint is assembled inside the Compose stack;
# do not put a token in BROWSERLESS_ENDPOINT.
BROWSERLESS_TOKEN=

# Safe defaults for local use.
HYEB_ALLOWED_ORIGINS=http://localhost:8787
HYEB_AUTOMATION_EXECUTOR_READY=false
API_PORT=8787
# HYEB_HA_NODE_ID=compose-api
# AUTOMATION_CONSUMER_NAME=compose-automation-worker
# AUTOMATION_CONTROL_CONSUMER_NAME=compose-automation-worker
