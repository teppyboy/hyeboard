{
  "name": "hyeboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @hyeboard/web --filter @hyeboard/worker dev",
    "serve": "pnpm --filter @hyeboard/worker serve:node",
    "serve:bun": "pnpm --filter @hyeboard/worker serve:bun",
    "dev:web": "pnpm --filter @hyeboard/web dev",
    "dev:worker": "pnpm --filter @hyeboard/worker dev",
    "dev:node": "concurrently -n web,worker -c blue,green \"pnpm --filter @hyeboard/web dev\" \"pnpm --filter @hyeboard/worker dev:node\"",
    "dev:bun": "concurrently -n web,worker -c blue,green \"pnpm --filter @hyeboard/web dev\" \"pnpm --filter @hyeboard/worker dev:bun\"",
    "build:web": "pnpm --filter @hyeboard/web build",
    "build:worker": "pnpm --filter @hyeboard/worker build",
    "build:node": "pnpm --filter @hyeboard/worker build:node",
    "package": "node scripts/package.mjs",
    "build": "pnpm build:web && pnpm build:worker && pnpm build:node",
    "deploy": "pnpm --filter @hyeboard/worker deploy",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && pnpm test:benchmark-lifecycle",
    "test:ha": "pnpm test:ha:postgres && pnpm test:ha:redis",
    "test:ha:postgres": "pnpm --filter @hyeboard/worker test:ha:postgres",
    "test:ha:redis": "pnpm --filter @hyeboard/worker test:ha:redis",
    "test:k8s": "node scripts/validate-k8s.mjs",
    "test:benchmark-lifecycle": "node scripts/run-benchmark-process-runner-tests.mjs",
    "test:browser": "pnpm --filter @hyeboard/web exec playwright test --retries=0",
    "test:fast": "node scripts/benchmark-test-runtime.mjs --runs=1 --label=fast",
    "benchmark:test-runtime": "node scripts/benchmark-test-runtime.mjs --runs=3 --label=acceptance",
    "audit:web-performance": "node scripts/audit-web-performance.mjs apps/web/dist",
    "audit:performance": "pnpm build:web && pnpm audit:web-performance"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
